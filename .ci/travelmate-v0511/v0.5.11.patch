+                new String[]{"bệnh viện"}, new String[]{"hospital"})) return false;
+        if (containsAny(s, "경찰") && !targetHas(t, toId,
+                new String[]{"cảnh sát"}, new String[]{"police"})) return false;
+        if (containsAny(s, "지갑") && !targetHas(t, toId,
+                new String[]{"ví"}, new String[]{"wallet"})) return false;
+        if (containsAny(s, "영수증") && !targetHas(t, toId,
+                new String[]{"hóa đơn", "biên lai"}, new String[]{"receipt"})) return false;
+        if (containsAny(s, "메뉴") && !targetHas(t, toId,
+                new String[]{"thực đơn", "menu"}, new String[]{"menu"})) return false;
+        if (containsAny(s, "짐", "수하물") && !targetHas(t, toId,
+                new String[]{"hành lý"}, new String[]{"luggage", "baggage"})) return false;
+        if (containsAny(s, "고수") && !targetHas(t, toId,
+                new String[]{"rau mùi", "ngò"}, new String[]{"cilantro", "coriander"})) return false;
+        if (containsAny(s, "맵", "매운") && !targetHas(t, toId,
+                new String[]{"cay"}, new String[]{"spicy"})) return false;
+
+        if (containsAny(s, "에어컨", "에어콘", "냉방") && containsAny(s, "켜", "틀어") &&
+                !targetHas(t, toId, new String[]{"bật"}, new String[]{"turn on", "switch on"})) return false;
+        if (containsAny(s, "에어컨", "에어콘", "냉방") && containsAny(s, "꺼", "끄") &&
+                !targetHas(t, toId, new String[]{"tắt"}, new String[]{"turn off", "switch off"})) return false;
+
+        return true;
+    }
+
+    private static String pick(String toId, String vi, String en) {
+        return "vi".equals(toId) ? vi : en;
+    }
+
+    private static boolean targetHas(String translated, String toId, String[] viTerms, String[] enTerms) {
+        String[] terms = "vi".equals(toId) ? viTerms : enTerms;
+        for (String term : terms) if (translated.contains(term)) return true;
+        return false;
+    }
+
+    private static boolean containsAny(String text, String... values) {
+        for (String value : values) if (text.contains(value)) return true;
+        return false;
+    }
+
+    private static String normalizeKorean(String text) {
+        return text.toLowerCase(Locale.ROOT)
+                .replaceAll("[\\s\\p{Punct}·…]+", "")
+                .replace("주세요", "주세요")
+                .trim();
+    }
