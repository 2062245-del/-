+    private String translatorKey(LanguageProfile from, LanguageProfile to) { return from.id + ">" + to.id; }
+
+    private Translator cachedTranslator(LanguageProfile from, LanguageProfile to) {
+        String key = translatorKey(from, to);
+        Translator existing = translatorCache.get(key);
+        if (existing != null) return existing;
+        TranslatorOptions options = new TranslatorOptions.Builder().setSourceLanguage(from.mlCode).setTargetLanguage(to.mlCode).build();
+        Translator created = Translation.getClient(options);
+        translatorCache.put(key, created);
+        return created;
+    }
+
+    private void prewarmCurrentPair() {
+        if (isFinishing() || isDestroyed() || leftSpinner == null || rightSpinner == null) return;
+        LanguageProfile left = currentLeft(), right = currentRight();
+        prewarmTranslationPair(left, right);
+        prewarmTranslationPair(right, left);
+    }
+
+    private void prewarmTranslationPair(LanguageProfile from, LanguageProfile to) {
+        if (from == null || to == null || !isPairTranslationReady(from, to)) return;
+        String key = translatorKey(from, to);
+        if (warmedTranslatorPairs.contains(key)) return;
+        warmedTranslatorPairs.add(key);
+        String sample = "ko".equals(from.id) ? "안녕하세요" : "vi".equals(from.id) ? "xin chào" : "hello";
+        try {
+            cachedTranslator(from, to).translate(sample).addOnFailureListener(e -> warmedTranslatorPairs.remove(key));
+        } catch (Throwable t) {
+            warmedTranslatorPairs.remove(key);
+        }
+    }
+
+    private void trimTranslatorCacheForPair(LanguageProfile left, LanguageProfile right) {
+        if (left == null || right == null) return;
+        String a = translatorKey(left, right), b = translatorKey(right, left);
+        for (String key : new ArrayList<>(translatorCache.keySet())) {
+            if (key.equals(a) || key.equals(b)) continue;
+            Translator t = translatorCache.remove(key);
+            warmedTranslatorPairs.remove(key);
+            if (t != null) try { t.close(); } catch (Throwable ignored) {}
+        }
+    }
