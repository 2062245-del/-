+    private void startListeningPulse() {
+        stopListeningPulse();
+        if (listeningPulseView == null) return;
+        listeningScaleX = ObjectAnimator.ofFloat(listeningPulseView, View.SCALE_X, 0.92f, 1.18f);
+        listeningScaleY = ObjectAnimator.ofFloat(listeningPulseView, View.SCALE_Y, 0.92f, 1.18f);
+        listeningAlpha = ObjectAnimator.ofFloat(listeningPulseView, View.ALPHA, 0.50f, 0.92f);
+        for (ObjectAnimator a : new ObjectAnimator[]{listeningScaleX, listeningScaleY, listeningAlpha}) {
+            a.setDuration(620L);
+            a.setRepeatCount(ValueAnimator.INFINITE);
+            a.setRepeatMode(ValueAnimator.REVERSE);
+            a.start();
+        }
+    }
+
+    private void updateListeningLevel(float rmsdB) {
+        if (listeningMicView == null) return;
+        float normalized = Math.max(0f, Math.min(1f, (rmsdB + 2f) / 12f));
+        float scale = 1.0f + normalized * 0.13f;
+        listeningMicView.animate().scaleX(scale).scaleY(scale).setDuration(80L).start();
+    }
+
+    private void stopListeningPulse() {
+        ObjectAnimator[] animators = new ObjectAnimator[]{listeningScaleX, listeningScaleY, listeningAlpha};
+        for (ObjectAnimator a : animators) if (a != null) { try { a.cancel(); } catch (Throwable ignored) {} }
+        listeningScaleX = null; listeningScaleY = null; listeningAlpha = null;
+    }
+
+    private void hideListeningOverlay() {
+        stopListeningPulse();
+        if (listeningDialog != null) {
+            Dialog d = listeningDialog;
+            listeningDialog = null;
+            try { d.setOnCancelListener(null); d.dismiss(); } catch (Throwable ignored) {}
+        }
+        listeningPulseView = null;
+        listeningMicView = null;
+        listeningTitleView = null;
+        listeningTranscriptView = null;
+    }
