+package com.seungho.barointerpreter;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+public final class TranslationVerification {
+    private TranslationVerification() {}
+
+    public static final class Report {
+        public final boolean caution;
+        public final List<String> lines;
+        Report(boolean caution, List<String> lines) { this.caution = caution; this.lines = lines; }
+        public String summary() {
+            StringBuilder b = new StringBuilder();
+            for (String line : lines) { if (b.length() > 0) b.append('\n'); b.append(line); }
+            return b.toString();
+        }
+    }
+
+    public static Report inspect(String source, String translated, String reverse) {
+        String s = clean(source), t = clean(translated), r = clean(reverse);
+        List<String> lines = new ArrayList<>();
+        boolean caution = false;
+        if (s.isEmpty() || t.isEmpty()) { lines.add("⚠ 원문 또는 번역문이 비어 있습니다."); return new Report(true, lines); }
+        Set<String> sourceNumbers = digitTokens(s);
+        if (!sourceNumbers.isEmpty()) {
+            Set<String> reverseNumbers = digitTokens(r);
+            if (reverseNumbers.containsAll(sourceNumbers)) lines.add("✓ 숫자/수량 표기가 역번역에도 유지됨");
+            else { lines.add("⚠ 숫자/수량 일부가 역번역에서 달라짐"); caution = true; }
+        } else lines.add("✓ 숫자 표기 누락 신호 없음");
+        Set<String> latin = latinTokens(s);
+        if (!latin.isEmpty()) {
+            String lowT = t.toLowerCase(Locale.ROOT), lowR = r.toLowerCase(Locale.ROOT);
+            boolean missing = false;
+            for (String token : latin) if (!lowT.contains(token) && !lowR.contains(token)) { missing = true; break; }
+            if (missing) { lines.add("⚠ 상품명·고유명사처럼 보이는 영문 토큰을 다시 확인하세요"); caution = true; }
+            else lines.add("✓ 영문 상품명·고유명사 보존 신호 양호");
+        }
+        if (hasKoreanNegation(s)) {
+            if (hasKoreanNegation(r)) lines.add("✓ 부정/제외 의미가 역번역에도 보임");
+            else { lines.add("⚠ ‘안/없음/빼기’ 같은 부정 의미가 약해졌을 수 있음"); caution = true; }
+        }
+        if (!r.isEmpty()) {
+            int sourceLetters = semanticLength(s), reverseLetters = semanticLength(r);
+            if (sourceLetters >= 8 && reverseLetters * 100 < sourceLetters * 45) { lines.add("⚠ 역번역이 원문보다 지나치게 짧습니다. 핵심 내용 누락 여부를 확인하세요"); caution = true; }
+            else lines.add("✓ 역번역 길이 급감 신호 없음");
+        } else { lines.add("⚠ 역번역 결과를 만들지 못했습니다."); caution = true; }
+        if (!caution) lines.add("원문과 역번역의 뜻이 비슷한지 마지막으로 직접 비교하세요.");
+        return new Report(caution, lines);
+    }
+
+    private static Set<String> digitTokens(String text) {
+        Set<String> out = new HashSet<>();
+        Matcher m = Pattern.compile("\\d+(?:[.,]\\d+)?").matcher(text);
+        while (m.find()) out.add(m.group().replace(",", ""));
+        return out;
+    }
+
+    private static Set<String> latinTokens(String text) {
+        Set<String> out = new HashSet<>();
+        Matcher m = Pattern.compile("[A-Za-z][A-Za-z0-9-]{1,}").matcher(text);
+        while (m.find()) out.add(m.group().toLowerCase(Locale.ROOT));
+        return out;
+    }
+
+    private static boolean hasKoreanNegation(String text) {
+        return text.contains("안 ") || text.contains("안돼") || text.contains("안 돼") || text.contains("못 ") || text.contains("없") || text.contains("빼") || text.contains("제외") || text.contains("말고") || text.contains("않");
+    }
+
+    private static int semanticLength(String text) { return text.replaceAll("[\\s\\p{Punct}]", "").length(); }
+    private static String clean(String s) { return s == null ? "" : s.trim(); }
+}
